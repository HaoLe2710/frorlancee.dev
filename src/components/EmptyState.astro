---
interface Props {
  title: string;
  description: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, actionLabel, actionHref } = Astro.props;
---

<div class="empty-state" role="status">
  <span class="empty-state__mark" aria-hidden="true">FD</span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
    {actionLabel && actionHref && <a href={actionHref} class="text-link">{actionLabel}<span aria-hidden="true"> →</span></a>}
  </div>
</div>

<style>
  .empty-state {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-surface);
  }

  .empty-state__mark {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(0 168 245 / 30%);
    border-radius: 0.85rem;
    color: var(--color-navy);
    background: rgb(0 168 245 / 8%);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .empty-state h3 {
    margin-bottom: 0.35rem;
    color: var(--color-navy);
    font-size: 1.12rem;
    font-weight: 650;
  }

  .empty-state p {
    max-width: 52ch;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .empty-state .text-link {
    display: inline-block;
    margin-top: 0.8rem;
  }

  @media (max-width: 520px) {
    .empty-state {
      grid-template-columns: 1fr;
    }
  }
</style>
