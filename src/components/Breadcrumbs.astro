---
interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Đường dẫn">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.label}</span>}
        {index < items.length - 1 && <span class="breadcrumbs__separator" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.5rem;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .breadcrumbs ol,
  .breadcrumbs li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .breadcrumbs__separator {
    color: #94a3b8;
  }
</style>
