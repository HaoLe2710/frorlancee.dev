---
interface Props {
  name?: string | null;
}

const { name = "website" } = Astro.props;
const iconPaths: Record<string, string> = {
  website: "M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5zM4 8h16M7 6h.01M10 6h.01M8 12h8M8 15h5",
  mobile: "M8 3.5h8A1.5 1.5 0 0 1 17.5 5v14a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 19V5A1.5 1.5 0 0 1 8 3.5ZM10 6h4M11 17.5h2",
  software: "M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5zM4 8h16M9 12l-2 2 2 2M15 12l2 2-2 2M13 11l-2 6",
  automation: "M5 6.5h6v5H5zM13 12.5h6v5h-6zM11 9h2a2 2 0 0 1 2 2v1.5M8 11.5v5h5",
};
const path = iconPaths[name ?? ""] ?? iconPaths.website;
---

<svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={path} />
</svg>

<style>
  .service-icon {
    width: 1.6rem;
    height: 1.6rem;
    flex: 0 0 auto;
    color: var(--color-blue);
  }
</style>
