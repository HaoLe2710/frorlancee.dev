---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const { entry: page, error, cacheHint } = await getEmDashEntry("pages", "privacy");
if (error) console.error("Unable to load the privacy page.");
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const seo = getSeoMeta(page, {
  siteUrl: Astro.url.origin,
  path: "/privacy",
  defaultDescription: page.data.summary || "Thông tin về dữ liệu được xử lý khi truy cập website Frorlancee Dev.",
});
---

<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description} canonical={seo.canonical} robots={seo.robots} content={{ collection: "pages", id: page.data.id, slug: "privacy" }}>
  <article class="shell privacy-page">
    <Breadcrumbs items={[{ label: "Quyền riêng tư" }]} />
    <header><p class="eyebrow">Thông tin website</p><h1>{page.data.title}</h1>{page.data.summary && <p>{page.data.summary}</p>}</header>
    {page.data.content && <div class="rich-content" {...page.edit.content}><PortableText value={page.data.content} /></div>}
  </article>
</Base>

<style>
  .privacy-page { max-width: 58rem; padding-block: 2rem 7rem; }
  header { max-width: 48rem; padding-block: 3rem 2rem; }
  header h1 { margin-top: .65rem; color: var(--color-navy); font-size: clamp(2.8rem, 6vw, 4.8rem); letter-spacing: -.06em; line-height: 1.05; }
  header > p:last-child { margin-top: 1rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.75; }
  .rich-content { max-width: 47rem; color: var(--color-text); font-size: 1rem; line-height: 1.85; }
  .rich-content :global(p) { margin-block: 0 1.3em; }
  .rich-content :global(h2) { margin-block: 2em .65em; color: var(--color-navy); font-size: 1.55rem; }
</style>
