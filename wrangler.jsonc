{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frorlancee-website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frorlancee-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "frorlancee-media"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
