{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frorlancee-website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "frorlanceedev.id.vn",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMDASH_SITE_URL": "https://frorlanceedev.id.vn"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frorlancee-db",
      "database_id": "ef7bb509-01a5-43ed-a39d-23afb2348f94"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "frorlancee-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "09eb75a300c849e79788e9718b4fc9f6"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
